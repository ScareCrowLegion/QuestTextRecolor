<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<PropertyGroup>

		<Version>1.3.1.0</Version>
		<AssemblyVersion>1.3.1.0</AssemblyVersion>
		<FileVersion>1.3.1.0</FileVersion>

		<AssemblyName>QuestTextRecolor</AssemblyName>
		<RootNamespace>QuestTextRecolor</RootNamespace>

		<Author>ScareCrowLegion</Author>
		<Name>Quest Text Recolor</Name>

		<Punchline>Customize quest objective text and popup layout.</Punchline>

		<Description>
			Customize FFXIV's center-screen quest objective popup with custom text colors, font size, position, scale, presets, and optional Penumbra-based textures.
		</Description>

		<RepoUrl>https://github.com/ScareCrowLegion/QuestTextRecolor</RepoUrl>

		<Tags>ui;quest;text;customization</Tags>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Penumbra.Api" Version="5.13.1" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Resources\Textures\ScreenInfo_hr1.tex">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Resources\Textures\060081_hr1.tex">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\Previews\ScreenInfo_Preview.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\Previews\060081_hr1_preview.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>